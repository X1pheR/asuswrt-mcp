# Required router connection.
ASUSWRT_HOST=192.168.1.1
ASUSWRT_SSH_PORT=22
ASUSWRT_SSH_USERNAME=admin

# Choose an SSH authentication method. Key authentication is recommended.
ASUSWRT_SSH_KEY_FILE=
ASUSWRT_SSH_PASSWORD=

# Optional SSH host-key verification. Enable after the router host key is trusted locally.
ASUSWRT_SSH_STRICT_HOST_KEY=false

# Mutations are disabled unless this is explicitly true.
ASUSWRT_ALLOW_MUTATIONS=false

# Optional runtime tuning.
ASUSWRT_TIMEOUT_SECONDS=10
ASUSWRT_CACHE_SECONDS=5
