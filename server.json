{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.teefloo/asuswrt-mcp",
  "description": "Model Context Protocol server for secure AsusWRT router administration via SSH. Provides 42+ read-only monitoring tools and guarded mutation tools for managing AsusWRT/Merlin routers.",
  "repository": {
    "url": "https://github.com/teefloo/asuswrt-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "asuswrt-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ASUSWRT_HOST",
          "description": "Router IP address (e.g., 192.168.1.1)",
          "isRequired": true,
          "format": "string"
        },
        {
          "name": "ASUSWRT_SSH_USERNAME",
          "description": "SSH username for router authentication",
          "isRequired": true,
          "format": "string"
        },
        {
          "name": "ASUSWRT_SSH_PASSWORD",
          "description": "SSH password for router authentication",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "ASUSWRT_SSH_KEY_FILE",
          "description": "Path to SSH private key file (alternative to password)",
          "isRequired": false,
          "format": "string"
        },
        {
          "name": "ASUSWRT_ALLOW_MUTATIONS",
          "description": "Enable mutation tools (default: false)",
          "isRequired": false,
          "format": "boolean"
        }
      ]
    }
  ]
}
